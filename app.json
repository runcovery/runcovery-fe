{
  "expo": {
    "name": "Runcovery",
    "slug": "runcovery-fe",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/app-icon-square.png",
    "scheme": "runcovery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon/Assets/app-icon-square.png",
      "bundleIdentifier": "com.jjong0923.runcoveryfe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/expo.icon/Assets/app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jjong0923.runcoveryfe"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/expo.icon/Assets/app-icon-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기반으로 날씨와 홈 정보를 제공하기 위해 위치 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d770ad3-1959-4711-bd90-e2985ab477cd"
      }
    }
  }
}
